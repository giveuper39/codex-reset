[Unit]
Description=Apply explicitly authorized earliest-expiring Codex reset %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/bin/codex_reset.py --apply --credit-id %i
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
TimeoutStartSec=240
