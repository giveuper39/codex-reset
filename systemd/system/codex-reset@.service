[Unit]
Description=Apply explicitly authorized earliest-expiring Codex reset %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=codex-reset
Group=codex-reset
WorkingDirectory=/opt/codex-reset
Environment=HOME=/var/lib/codex-reset
Environment=PATH=/var/lib/codex-reset/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /opt/codex-reset/codex_reset.py --apply --credit-id %i
UMask=0077
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codex-reset
